{
  "info": {
    "name": "Evaluación 3 - API Soporte Técnico",
    "description": "Ejecutar con el Collection Runner EN ORDEN. Requiere los usuarios de prueba del README (admin, ana, beto), el servidor en http://127.0.0.1:8000 y 'Automatically follow redirects' activado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Django exige el token CSRF en el header X-CSRFToken para escrituras con sesión.",
          "const token = pm.cookies.get('csrftoken');",
          "if (token) { pm.request.headers.upsert({ key: 'X-CSRFToken', value: token }); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "pass_admin",
      "value": "Admin12345"
    },
    {
      "key": "pass_usuario",
      "value": "Usuario12345"
    },
    {
      "key": "solicitud_id",
      "value": ""
    },
    {
      "key": "ajena_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Abrir login (entrega cookie csrftoken)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api-auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api-auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK - cookie csrftoken recibida', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Login beto",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api-auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api-auth",
            "login"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "beto",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{pass_usuario}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login correcto: redirige y responde JSON (sesión creada)', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('json');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 beto crea una solicitud (será la 'ajena')",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/solicitudes/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "solicitudes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Sin internet\",\n  \"descripcion\": \"No hay red en el segundo piso\",\n  \"categoria\": \"Redes\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('ajena_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
